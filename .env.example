# Copy this file to ".env" and fill in your keys. .env is gitignored.

# Live signal (bot/ai_signal.py) — Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# AI-signal backtester (bot/ai_backtest.py) — Pydantic AI Gateway -> Doubleword
# (OpenAI-compatible). Get this from the gateway's "Connect" tab.
PYDANTIC_AI_GATEWAY_API_KEY=pylf_v2_eu_your-key-here

# Nemotron second opinion (bot/second_opinion.py) — NVIDIA hosted inference.
# Get an "nvapi-..." key from a model page at https://build.nvidia.com.
# When unset, the engine runs Claude-only (second opinion disabled).
NVIDIA_API_KEY=nvapi-your-key-here
# Optional: override the default endpoint if NVIDIA changes it.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
